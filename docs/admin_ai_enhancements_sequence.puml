@startuml Admin_AI_Enhancements_Sequence
!theme plain
autonumber

actor Admin
participant "Admin Dashboard (React)" as FE
participant "Betting.Api" as API
participant "AiAssistantService" as Service
participant "CustomBet.Api" as CBApi
participant "CustomBetService" as CBService
participant "Google Gemini API" as Gemini

== AI Insights Analytics: Regeneracja ==
Admin -> FE : Kliknięcie "Regeneruj" przy meczu
FE -> API : POST /api/AiAssistant/event/{eventId}/regenerate
activate API
API -> Service : RegenerateInsightAsync(eventId)
activate Service
Service -> Gemini : GenerateTextAsync(Context Injection)
Gemini --> Service : Nowa analiza
Service -> Service : Logowanie do AiGenerationLogs
Service --> API : Success (New Insight)
deactivate Service
API --> FE : 200 OK { insight: "..." }
deactivate API
FE -> Admin : Odświeżenie widoku analizy

== Custom Bet: Rekomendacja AI ==
Admin -> FE : Wejście w szczegóły wniosku Custom Bet
FE -> CBApi : GET /api/CustomBet/{id}/recommendation
activate CBApi
CBApi -> CBService : GetAiRecommendationAsync(id)
activate CBService
CBService -> Gemini : AnalyzeRequestAsync(Description)
activate Gemini
Gemini --> CBService : JSON { odds, risk, reasoning, category }
deactivate Gemini
CBService -> CBService : Update Request with AI Data
CBService --> CBApi : Request z danymi AI
deactivate CBService
CBApi --> FE : 200 OK (CustomBetDto z AI)
deactivate CBApi
FE -> Admin : Wyświetlenie sugestii AI (kurs, ryzyko)
@enduml