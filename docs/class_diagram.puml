@startuml 67Bet_ClassDiagram
!theme plain
scale max 2400 width
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members

title 67Bet - Diagram klas UML I wersji systemu

legend right
  <<implemented>> - element istnieje juz w kodzie projektu
  <<planned>> - element wynika z zalozen projektu / README,
                ale nie jest jeszcze osobna klasa w kodzie
  Linia ciagla - relacja domenowa lub relacja w ramach jednego modulu
  Linia przerywana - powiazanie logiczne przez identyfikator, REST/API
                     albo planowana zaleznosc miedzy mikroserwisami
endlegend

package "Shared Kernel" {
    abstract class BaseEntity <<implemented, abstract>> {
        #Id : Guid
        #CreatedAt : DateTime
    }

    interface IAggregateRoot <<implemented, marker>>
}

package "Identity Service" {
    enum Role <<implemented>> {
        Admin
        User
    }

    class User <<implemented, AggregateRoot>> {
        +Username : string
        +Email : string
        +PasswordHash : string
        +UserRole : Role
        +User(username: string, email: string, passwordHash: string, role: Role)
        +ChangeRole(newRole: Role) : void
    }

    interface IUserRepository <<implemented>> {
        +GetByIdAsync(id: Guid) : Task<User?>
        +GetByEmailAsync(email: string) : Task<User?>
        +AddAsync(user: User) : Task
        +UpdateAsync(user: User) : Task
    }

    interface IIdentityService <<implemented>> {
        +GetUserByIdAsync(userId: Guid) : Task<User?>
        +GetUserByEmailAsync(email: string) : Task<User?>
        +RegisterAsync(username: string, email: string, password: string) : Task<User>
        +AuthenticateAsync(email: string, password: string) : Task<bool>
    }

    class UserRepository <<implemented>> {
        -_context : IdentityDbContext
        +GetByIdAsync(id: Guid) : Task<User?>
        +GetByEmailAsync(email: string) : Task<User?>
        +AddAsync(user: User) : Task
        +UpdateAsync(user: User) : Task
    }

    class IdentityService <<implemented>> {
        -_userRepository : IUserRepository
        +GetUserByIdAsync(userId: Guid) : Task<User?>
        +GetUserByEmailAsync(email: string) : Task<User?>
        +RegisterAsync(username: string, email: string, password: string) : Task<User>
        +AuthenticateAsync(email: string, password: string) : Task<bool>
    }

    class IdentityDbContext <<implemented>> {
        +Users : DbSet<User>
        #OnModelCreating(modelBuilder: ModelBuilder) : void
    }
}

package "Wallet Service" {
    enum TransactionType <<implemented>> {
        Deposit
        Withdrawal
        Stake
        Payout
    }

    enum TransactionStatus <<implemented>> {
        Pending
        Completed
        Failed
    }

    class Wallet <<implemented, AggregateRoot>> {
        +UserId : Guid
        +Balance : decimal
        +Currency : string
        +Version : int
        +Wallet(userId: Guid, currency: string)
        +Deposit(amount: decimal) : void
        +Withdraw(amount: decimal) : void
    }

    class Transaction <<implemented>> {
        +WalletId : Guid
        +Amount : decimal
        +Type : TransactionType
        +Status : TransactionStatus
        +Transaction(walletId: Guid, amount: decimal, type: TransactionType)
        +Complete() : void
        +Fail() : void
    }

    interface IWalletRepository <<implemented>> {
        +GetByUserIdAsync(userId: Guid) : Task<Wallet?>
        +GetByIdAsync(id: Guid) : Task<Wallet?>
        +AddAsync(wallet: Wallet) : Task
        +UpdateAsync(wallet: Wallet) : Task
    }

    interface ITransactionRepository <<implemented>> {
        +GetByIdAsync(id: Guid) : Task<Transaction?>
        +GetByWalletIdAsync(walletId: Guid) : Task<IEnumerable<Transaction>>
        +AddAsync(transaction: Transaction) : Task
        +UpdateAsync(transaction: Transaction) : Task
    }

    interface IWalletService <<implemented>> {
        +GetBalanceAsync(userId: Guid) : Task<decimal>
        +DepositAsync(userId: Guid, amount: decimal) : Task
        +WithdrawAsync(userId: Guid, amount: decimal) : Task
        +ProcessStakeAsync(userId: Guid, amount: decimal) : Task<bool>
        +ProcessPayoutAsync(userId: Guid, amount: decimal) : Task
        +GetWalletByUserIdAsync(userId: Guid) : Task<Wallet?>
    }

    class WalletRepository <<implemented>> {
        -_context : WalletDbContext
        +GetByUserIdAsync(userId: Guid) : Task<Wallet?>
        +GetByIdAsync(id: Guid) : Task<Wallet?>
        +AddAsync(wallet: Wallet) : Task
        +UpdateAsync(wallet: Wallet) : Task
    }

    class TransactionRepository <<implemented>> {
        -_context : WalletDbContext
        +GetByIdAsync(id: Guid) : Task<Transaction?>
        +GetByWalletIdAsync(walletId: Guid) : Task<IEnumerable<Transaction>>
        +AddAsync(transaction: Transaction) : Task
        +UpdateAsync(transaction: Transaction) : Task
    }

    class WalletService <<implemented>> {
        -_walletRepository : IWalletRepository
        -_transactionRepository : ITransactionRepository
        +GetBalanceAsync(userId: Guid) : Task<decimal>
        +DepositAsync(userId: Guid, amount: decimal) : Task
        +WithdrawAsync(userId: Guid, amount: decimal) : Task
        +ProcessStakeAsync(userId: Guid, amount: decimal) : Task<bool>
        +ProcessPayoutAsync(userId: Guid, amount: decimal) : Task
        +GetWalletByUserIdAsync(userId: Guid) : Task<Wallet?>
        -GetOrCreateWalletAsync(userId: Guid) : Task<Wallet>
    }

    class WalletDbContext <<implemented>> {
        +Wallets : DbSet<Wallet>
        +Transactions : DbSet<Transaction>
        #OnModelCreating(modelBuilder: ModelBuilder) : void
    }
}

package "Betting Service" {
    enum EventStatus <<implemented>> {
        Scheduled
        Live
        Finished
        Cancelled
    }

    enum TicketStatus <<implemented>> {
        Pending
        Won
        Lost
        Cancelled
    }

    enum BetStatus <<implemented>> {
        Pending
        Won
        Lost
    }

    class Sport <<implemented, AggregateRoot>> {
        +Name : string
        +Sport(name: string)
    }

    class Event <<implemented, AggregateRoot>> {
        +SportId : Guid
        +Name : string
        +StartTime : DateTime
        +Status : EventStatus
        +Metadata : string
        +Event(sportId: Guid, name: string, startTime: DateTime, metadata: string)
        +UpdateStatus(status: EventStatus) : void
    }

    class Market <<implemented>> {
        +EventId : Guid
        +Name : string
        +IsActive : bool
        +Outcomes : List<Outcome>
        +Market(eventId: Guid, name: string)
        +Deactivate() : void
        +Activate() : void
    }

    class Outcome <<implemented>> {
        +MarketId : Guid
        +Name : string
        +Probability : decimal
        +CurrentPrice : decimal
        +IsWinner : bool?
        +Outcome(marketId: Guid, name: string, probability: decimal, currentPrice: decimal)
        +SetResult(isWinner: bool) : void
        +UpdatePrice(newPrice: decimal, newProbability: decimal) : void
    }

    class Ticket <<implemented, AggregateRoot>> {
        +UserId : Guid
        +TotalOdds : decimal
        +Stake : decimal
        +PotentialWinning : decimal
        +Status : TicketStatus
        +Bets : List<Bet>
        +Ticket(userId: Guid, stake: decimal)
        +AddBet(outcomeId: Guid, fixedPrice: decimal) : void
        -CalculateTotalOdds() : void
        +Settle(status: TicketStatus) : void
    }

    class Bet <<implemented>> {
        +TicketId : Guid
        +OutcomeId : Guid
        +FixedPrice : decimal
        +Status : BetStatus
        +Bet(ticketId: Guid, outcomeId: Guid, fixedPrice: decimal)
        +Settle(status: BetStatus) : void
    }

    interface ISportRepository <<implemented>> {
        +GetByIdAsync(id: Guid) : Task<Sport?>
        +GetAllAsync() : Task<IEnumerable<Sport>>
        +AddAsync(sport: Sport) : Task
    }

    interface IEventRepository <<implemented>> {
        +GetByIdAsync(id: Guid) : Task<Event?>
        +GetActiveEventsAsync() : Task<IEnumerable<Event>>
        +AddAsync(event: Event) : Task
        +UpdateAsync(event: Event) : Task
    }

    interface IMarketRepository <<implemented>> {
        +GetByIdAsync(id: Guid) : Task<Market?>
        +GetByEventIdAsync(eventId: Guid) : Task<IEnumerable<Market>>
        +AddAsync(market: Market) : Task
    }

    interface ITicketRepository <<implemented>> {
        +GetByIdAsync(id: Guid) : Task<Ticket?>
        +GetByUserIdAsync(userId: Guid) : Task<IEnumerable<Ticket>>
        +AddAsync(ticket: Ticket) : Task
        +UpdateAsync(ticket: Ticket) : Task
    }

    interface IBettingService <<implemented>> {
        +GetActiveEventsAsync() : Task<IEnumerable<Event>>
        +PlaceTicketAsync(userId: Guid, stake: decimal, outcomeIds: IEnumerable<Guid>) : Task<Ticket>
        +SettleEventAsync(eventId: Guid, winningOutcomeIds: List<Guid>) : Task
        +GetTicketByIdAsync(ticketId: Guid) : Task<Ticket?>
        +GetUserTicketsAsync(userId: Guid) : Task<IEnumerable<Ticket>>
    }

    class SportRepository <<implemented>> {
        -_context : BettingDbContext
        +GetByIdAsync(id: Guid) : Task<Sport?>
        +GetAllAsync() : Task<IEnumerable<Sport>>
        +AddAsync(sport: Sport) : Task
    }

    class EventRepository <<implemented>> {
        -_context : BettingDbContext
        +GetByIdAsync(id: Guid) : Task<Event?>
        +GetActiveEventsAsync() : Task<IEnumerable<Event>>
        +AddAsync(event: Event) : Task
        +UpdateAsync(event: Event) : Task
    }

    class MarketRepository <<implemented>> {
        -_context : BettingDbContext
        +GetByIdAsync(id: Guid) : Task<Market?>
        +GetByEventIdAsync(eventId: Guid) : Task<IEnumerable<Market>>
        +AddAsync(market: Market) : Task
    }

    class TicketRepository <<implemented>> {
        -_context : BettingDbContext
        +GetByIdAsync(id: Guid) : Task<Ticket?>
        +GetByUserIdAsync(userId: Guid) : Task<IEnumerable<Ticket>>
        +AddAsync(ticket: Ticket) : Task
        +UpdateAsync(ticket: Ticket) : Task
    }

    class BettingService <<implemented>> {
        -_eventRepository : IEventRepository
        -_marketRepository : IMarketRepository
        -_ticketRepository : ITicketRepository
        +GetActiveEventsAsync() : Task<IEnumerable<Event>>
        +PlaceTicketAsync(userId: Guid, stake: decimal, outcomeIds: IEnumerable<Guid>) : Task<Ticket>
        +SettleEventAsync(eventId: Guid, winningOutcomeIds: List<Guid>) : Task
        +GetTicketByIdAsync(ticketId: Guid) : Task<Ticket?>
        +GetUserTicketsAsync(userId: Guid) : Task<IEnumerable<Ticket>>
    }

    class BettingDbContext <<implemented>> {
        +Sports : DbSet<Sport>
        +Events : DbSet<Event>
        +Markets : DbSet<Market>
        +Outcomes : DbSet<Outcome>
        +Tickets : DbSet<Ticket>
        +Bets : DbSet<Bet>
        #OnModelCreating(modelBuilder: ModelBuilder) : void
    }
}

package "Odds Service" {
    interface IOddsService <<implemented>> {
        +CalculateOddsAsync(probability: decimal) : Task<decimal>
        +UpdateMarketOddsAsync(marketId: Guid) : Task
        +GetLiveProbabilityAsync(eventId: Guid, contextJson: string) : Task<decimal>
    }

    class OddsService <<implemented>> {
        +CalculateOddsAsync(probability: decimal) : Task<decimal>
        +UpdateMarketOddsAsync(marketId: Guid) : Task
        +GetLiveProbabilityAsync(eventId: Guid, contextJson: string) : Task<decimal>
    }
}

package "Custom Bet Service" {
    enum RequestStatus <<implemented>> {
        Pending
        Reviewing
        Accepted
        Rejected
    }

    class CustomBetRequest <<implemented, AggregateRoot>> {
        +UserId : Guid
        +Description : string
        +AiSuggestedOdds : decimal
        +AdminFinalOdds : decimal?
        +Status : RequestStatus
        +AdminNote : string?
        +CustomBetRequest(userId: Guid, description: string)
        +SetAiSuggestedOdds(odds: decimal) : void
        +Accept(finalOdds: decimal, note: string?) : void
        +Reject(reason: string) : void
    }

    interface ICustomBetRepository <<implemented>> {
        +GetByIdAsync(id: Guid) : Task<CustomBetRequest?>
        +GetByUserIdAsync(userId: Guid) : Task<IEnumerable<CustomBetRequest>>
        +GetPendingRequestsAsync() : Task<IEnumerable<CustomBetRequest>>
        +AddAsync(request: CustomBetRequest) : Task
        +UpdateAsync(request: CustomBetRequest) : Task
    }

    interface ICustomBetService <<implemented>> {
        +CreateRequestAsync(userId: Guid, description: string) : Task<CustomBetRequest>
        +GetUserRequestsAsync(userId: Guid) : Task<IEnumerable<CustomBetRequest>>
        +GetPendingRequestsAsync() : Task<IEnumerable<CustomBetRequest>>
        +AcceptRequestAsync(requestId: Guid, finalOdds: decimal, adminNote: string?) : Task
        +RejectRequestAsync(requestId: Guid, reason: string) : Task
    }

    class CustomBetRepository <<implemented>> {
        -_context : CustomBetDbContext
        +GetByIdAsync(id: Guid) : Task<CustomBetRequest?>
        +GetByUserIdAsync(userId: Guid) : Task<IEnumerable<CustomBetRequest>>
        +GetPendingRequestsAsync() : Task<IEnumerable<CustomBetRequest>>
        +AddAsync(request: CustomBetRequest) : Task
        +UpdateAsync(request: CustomBetRequest) : Task
    }

    class CustomBetService <<implemented>> {
        -_customBetRepository : ICustomBetRepository
        +CreateRequestAsync(userId: Guid, description: string) : Task<CustomBetRequest>
        +GetUserRequestsAsync(userId: Guid) : Task<IEnumerable<CustomBetRequest>>
        +GetPendingRequestsAsync() : Task<IEnumerable<CustomBetRequest>>
        +AcceptRequestAsync(requestId: Guid, finalOdds: decimal, adminNote: string?) : Task
        +RejectRequestAsync(requestId: Guid, reason: string) : Task
    }

    class CustomBetDbContext <<implemented>> {
        +CustomBetRequests : DbSet<CustomBetRequest>
        #OnModelCreating(modelBuilder: ModelBuilder) : void
    }
}

package "Elementy planowane / rozszerzenia" {
    interface ISettlementService <<planned>> {
        +SettleTicketsForEventAsync(eventId: Guid) : Task
        +SettleTicketAsync(ticketId: Guid) : Task
    }

    interface IRealtimeOddsNotifier <<planned>> {
        +PublishOddsChangedAsync(outcomeId: Guid, currentPrice: decimal) : Task
        +PublishMarketSuspendedAsync(marketId: Guid) : Task
    }

    class SettlementService <<planned>>
    class SignalROddsNotifier <<planned>>
}

' Dziedziczenie po wspolnej klasie bazowej
BaseEntity <|-- User
BaseEntity <|-- Wallet
BaseEntity <|-- Transaction
BaseEntity <|-- Sport
BaseEntity <|-- Event
BaseEntity <|-- Market
BaseEntity <|-- Outcome
BaseEntity <|-- Ticket
BaseEntity <|-- Bet
BaseEntity <|-- CustomBetRequest

' Agregaty domenowe
User ..|> IAggregateRoot
Wallet ..|> IAggregateRoot
Sport ..|> IAggregateRoot
Event ..|> IAggregateRoot
Ticket ..|> IAggregateRoot
CustomBetRequest ..|> IAggregateRoot

' Relacje domenowe i logiczne
User "1" ..> "1" Wallet : UserId / logical cross-service
User "1" ..> "0..*" Ticket : UserId / logical cross-service
User "1" ..> "0..*" CustomBetRequest : UserId / logical cross-service
Wallet "1" -- "0..*" Transaction : WalletId
Sport "1" -- "0..*" Event : SportId
Event "1" -- "0..*" Market : EventId
Market "1" *-- "0..*" Outcome : contains
Ticket "1" *-- "0..*" Bet : contains
Bet "0..*" ..> "1" Outcome : OutcomeId

' Typy wyliczeniowe
User --> Role
Transaction --> TransactionType
Transaction --> TransactionStatus
Event --> EventStatus
Ticket --> TicketStatus
Bet --> BetStatus
CustomBetRequest --> RequestStatus

' Repozytoria i implementacje DAL
IUserRepository <|.. UserRepository
UserRepository --> IdentityDbContext : uses
IdentityDbContext --> User : DbSet

IWalletRepository <|.. WalletRepository
ITransactionRepository <|.. TransactionRepository
WalletRepository --> WalletDbContext : uses
TransactionRepository --> WalletDbContext : uses
WalletDbContext --> Wallet : DbSet
WalletDbContext --> Transaction : DbSet

ISportRepository <|.. SportRepository
IEventRepository <|.. EventRepository
IMarketRepository <|.. MarketRepository
ITicketRepository <|.. TicketRepository
SportRepository --> BettingDbContext : uses
EventRepository --> BettingDbContext : uses
MarketRepository --> BettingDbContext : uses
TicketRepository --> BettingDbContext : uses
BettingDbContext --> Sport : DbSet
BettingDbContext --> Event : DbSet
BettingDbContext --> Market : DbSet
BettingDbContext --> Outcome : DbSet
BettingDbContext --> Ticket : DbSet
BettingDbContext --> Bet : DbSet

ICustomBetRepository <|.. CustomBetRepository
CustomBetRepository --> CustomBetDbContext : uses
CustomBetDbContext --> CustomBetRequest : DbSet

' Serwisy aplikacyjne / BLL zaimplementowane w kodzie
IIdentityService <|.. IdentityService
IWalletService <|.. WalletService
IBettingService <|.. BettingService
IOddsService <|.. OddsService
ICustomBetService <|.. CustomBetService

IdentityService ..> IUserRepository : uses
WalletService ..> IWalletRepository : uses
WalletService ..> ITransactionRepository : uses
BettingService ..> IEventRepository : uses
BettingService ..> IMarketRepository : uses
BettingService ..> ITicketRepository : uses
CustomBetService ..> ICustomBetRepository : uses

' Logiczne / planowane zaleznosci miedzy mikroserwisami
BettingService ..> WalletService : stake/payout through API (planned integration)
CustomBetService ..> OddsService : AI odds suggestion (planned integration)
SettlementService ..> ITicketRepository : planned settlement
SettlementService ..> WalletService : planned payout through API
OddsService ..> IRealtimeOddsNotifier : planned SignalR notification
SignalROddsNotifier ..> Outcome : publishes price changes

note right of Wallet
Version pelni role znacznika
optimistic concurrency.
Chroni saldo przed konfliktami
przy jednoczesnych operacjach.
end note

note right of Outcome
Probability przechowuje wynik modelu AI,
a CurrentPrice jest finalnym kursem
dostepnym dla gracza.
end note

note bottom of Ticket
Ticket reprezentuje kupon.
Bet przechowuje FixedPrice,
czyli kurs z momentu zawarcia zakladu.
end note

note bottom of User
Powiazania User -> Wallet/Ticket/CustomBetRequest
sa celowo pokazane jako logiczne.
W kodzie i w mikroserwisach sa realizowane
przez UserId, a nie przez bezposrednie pola nawigacyjne.
end note

@enduml
