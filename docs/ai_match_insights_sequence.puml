@startuml AI_Match_Insights_Sequence
!theme plain
autonumber

actor User
participant "Frontend (React)" as FE
participant "Betting.Api (Controller)" as API
participant "AiAssistantService" as Service
participant "AiMatchInsightRepository" as Repo
database "MySQL (BettingDB)" as DB
participant "OddsIntegrationService" as OddsAPI
participant "Google Gemini API" as Gemini

User -> FE : Kliknięcie "Zapytaj AI o typ"
FE -> API : GET /api/events/{eventId}/insight
activate API

API -> Service : GetMatchInsightAsync(eventId)
activate Service

Service -> Repo : GetByEventIdAsync(eventId)
activate Repo
Repo -> DB : SELECT * FROM AiMatchInsights WHERE EventId = {eventId}
DB --> Repo : Result (null or Insight)
Repo --> Service : AiMatchInsight?
deactivate Repo

alt Cache Hit (Wskazówka istnieje w bazie i jest aktualna)
    Service --> API : Content (z bazy)
else Cache Miss (Brak lub nieaktualna wskazówka)
    Service -> OddsAPI : GetRecentScoresAsync(sportKey, daysFrom)
    activate OddsAPI
    OddsAPI --> Service : RecentScores (JSON)
    deactivate OddsAPI

    Service -> OddsAPI : GetCurrentOddsAsync(eventId)
    activate OddsAPI
    OddsAPI --> Service : CurrentOdds (JSON)
    deactivate OddsAPI

    Service -> Service : Zbudowanie kontekstu (RAG / Context Injection)

    Service -> Gemini : GenerateTextAsync(Prompt z kontekstem: wyniki i kursy)
    activate Gemini
    Gemini --> Service : Wygenerowany tekst (Insight)
    deactivate Gemini

    Service -> Repo : AddOrUpdateAsync(AiMatchInsight)
    activate Repo
    Repo -> DB : INSERT / UPDATE INTO AiMatchInsights (...)
    DB --> Repo : Success
    Repo --> Service : Success
    deactivate Repo

    Service --> API : Wygenerowany tekst
end

deactivate Service

API --> FE : JSON { insight: "..." }
deactivate API

FE -> User : Wyświetlenie analizy AI opartej o fakty
@enduml
